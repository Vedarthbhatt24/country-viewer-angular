  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --code-coverage --no-progress --browsers=ChromeHeadless || exit 0",
    "version-stamp": "npm version 1.0.0-$(Get-Date -Format 'yyyyMMdd-HHmm') --no-git-tag-version",
